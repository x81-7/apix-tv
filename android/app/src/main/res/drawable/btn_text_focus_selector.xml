<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - Prominent gold border for TV D-pad navigation -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFD700" />
            <corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FFD700" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Default state - Transparent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

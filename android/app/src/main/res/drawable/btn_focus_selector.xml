<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - Very prominent gold border with glow for TV remote -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#44FFD700" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <!-- Inner area with thick gold border -->
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#22FFD700" />
                    <corners android:radius="25dp" />
                    <stroke android:width="3dp" android:color="#FFD700" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FFD700" />
            <corners android:radius="25dp" />
            <stroke android:width="3dp" android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Default state - Subtle background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</selector>

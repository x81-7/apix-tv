<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - Prominent gold border with glow -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#55FFD700" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Inner background -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#33FFD700" />
                    <corners android:radius="10dp" />
                    <stroke android:width="3dp" android:color="#FFD700" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#66FFD700" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Default state - Transparent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

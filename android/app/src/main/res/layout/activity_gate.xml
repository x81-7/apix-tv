<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/gate_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تشغيل يدوي"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/gate_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أدخل بيانات البث أو كود الدخول"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اسم القناة"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="#FFD700"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="3dp"
            app:hintTextColor="#FFD700"
            android:textColorHint="#CCCCCC"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#1A1A1A">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gate_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/gate_link"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_link"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رابط القناة"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="#FFD700"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="3dp"
            app:hintTextColor="#FFD700"
            android:textColorHint="#CCCCCC"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#1A1A1A">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gate_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/gate_name"
                android:nextFocusDown="@+id/gate_ua"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_ua"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="يوزر ايجنت"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="#FFD700"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="3dp"
            app:hintTextColor="#FFD700"
            android:textColorHint="#CCCCCC"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#1A1A1A">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gate_ua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/gate_link"
                android:nextFocusDown="@+id/gate_referer"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_referer"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ريفرر"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="#FFD700"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="3dp"
            app:hintTextColor="#FFD700"
            android:textColorHint="#CCCCCC"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#1A1A1A">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gate_referer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/gate_ua"
                android:nextFocusDown="@+id/gate_clearkey"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_clearkey"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ClearKey"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="#FFD700"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="3dp"
            app:hintTextColor="#FFD700"
            android:textColorHint="#CCCCCC"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#1A1A1A">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gate_clearkey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/gate_referer"
                android:nextFocusDown="@+id/gate_play"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gate_play"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="تشغيل"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp"
                app:backgroundTint="#FFD700"
                app:cornerRadius="12dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/gate_clearkey"
                android:nextFocusRight="@+id/gate_telegram"
                android:nextFocusDown="@+id/gate_about"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gate_telegram"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="تلجرام"
                android:textColor="#FFD700"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:strokeColor="#FFD700"
                app:strokeWidth="2dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/gate_play"
                android:nextFocusDown="@+id/gate_about" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gate_about"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="حول التطبيق وسياسة الخصوصية"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/gate_play"
            app:cornerRadius="12dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp" />

    </LinearLayout>
</ScrollView>
